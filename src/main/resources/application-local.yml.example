# Copy to application-local.yml for machine-specific settings (optional).
# Prefer environment variables from .env for secrets.
#
#   cp application-local.yml.example application-local.yml
#
# application-local.yml is listed in .gitignore and must not be committed.

spring:
  datasource:
    url: ${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/expense_manager}
    username: ${SPRING_DATASOURCE_USERNAME:expense_manager}
    password: ${SPRING_DATASOURCE_PASSWORD:change-me}
    driver-class-name: org.postgresql.Driver

  jpa:
    show-sql: true

logging:
  level:
    root: INFO
    com.expensemanager: DEBUG
    org.hibernate.SQL: DEBUG
    org.flywaydb: INFO
    org.springframework.security: DEBUG

security:
  jwt:
    access-secret: 6rY9nQ4mT2xP8kL5sW1jH7dF3vB0cN6zA4qR8uE2tY9
    refresh-secret: 7mP3vK9tD5xL1nR8qW4fJ2sH6cB0zA7uE3yT9gN5
    access-expiration: 900000
    refresh-expiration: 604800000
